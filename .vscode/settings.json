{
  "nixEnvSelector.namedConfigurations": [
    {
      "name": "frostflake-dev",
      "nixFile": "flake.nix",
      "profile": "default"
    }
  ],
  "nixEnvSelector.defaultNixFile": "flake.nix",
  "nixEnvSelector.defaultProfile": "default",
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "import (builtins.getFlake \".\").inputs.nixpkgs"
      },
      "formatting": {
        "command": [
          "alejandra"
        ]
      },
      "options": {
        "experimental": true
      }
    }
  },
  "json.schemas": [
    {
      "fileMatch": [
        "flake.lock"
      ],
      "url": "https://raw.githubusercontent.com/NixOS/nixpkgs/master/pkgs/top-level/flake-lock.schema.json"
    }
  ],
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },
  "direnv.restart.automatic": true,
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "files.watcherExclude": {
    "**/.direnv/**": true,
    "**/result": true,
    "**/result-*": true,
    "**/node_modules/**": true,
    "**/.git/**": true
  },
  "search.exclude": {
    "**/.direnv/**": true,
    "**/result": true,
    "**/result-*": true,
    "**/node_modules/**": true
  },
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "prettier.enable": false,
  "files.eol": "\n"
}